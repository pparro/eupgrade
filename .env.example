# Copy to .env.local for local dev, and set the same two vars in Vercel's
# project settings (Settings → Environment Variables) for production.
# The anon key is safe to expose in client code — Row Level Security is what
# protects your data. Never put the service_role key here.
#
# These power the "coming soon" waitlist form (src/notify.js). Create a
# `waitlist` table with an INSERT policy for the anon role:
#   create table waitlist (
#     id uuid primary key default gen_random_uuid(),
#     email text unique not null,
#     created_at timestamptz default now()
#   );
#   alter table waitlist enable row level security;
#   create policy "anon can join waitlist" on waitlist
#     for insert to anon with check (true);
# Until both vars are set, the form honestly says sign-ups aren't open yet.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
